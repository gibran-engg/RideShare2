# Copy to .env and fill in. Every value has a development default, so `npm run dev` works without a .env.

NODE_ENV=development

# Required in production: long random strings.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# Signs payment gateway callbacks so a forged "paid" is rejected.
PAYMENT_WEBHOOK_SECRET=

# ---- Map (MapTiler) ----
# Free key at https://cloud.maptiler.com (no card). Without it the map falls back to CARTO tiles,
# which show an "API KEY REQUIRED" watermark.
MAPTILER_KEY=
# MAPTILER_STYLE=dataviz-dark

# ---- Web app ----
# Where the browser version of the app runs (Expo web dev server).
# WEB_URL=http://localhost:5173

# ---- Payments ----
# Only "mock" (test-mode checkout page) exists for now.
# PAYMENT_PROVIDER=mock

# ---- Reaching the API from your phone ----
# By default the API is announced on this PC's Wi-Fi IP (auto-detected), e.g. http://192.168.1.37:3000.
# DEV_HOST=192.168.1.37

# ---- Sign-in: Auth0 (IAM) ----
# Step-by-step setup (API, the two applications, roles, the three users, the roles Action):
# docs/auth0-setup.md. Until these are set, the local Dev sign-in (mock-oauth/) stands in for Auth0.
# Your tenant's domain, e.g. rideshare-dev.us.auth0.com
AUTH0_DOMAIN=
# The API identifier from Auth0 -> Applications -> APIs; access tokens (JWTs) must be issued for it.
AUTH0_AUDIENCE=
# "RideShare App" (Native application, used by the Android app and its browser version). No secret.
AUTH0_APP_CLIENT_ID=
# "RideShare Admin" (Regular Web Application, used by the admin website).
AUTH0_ADMIN_CLIENT_ID=
AUTH0_ADMIN_CLIENT_SECRET=
# Custom claim the Auth0 Post-Login Action fills with the user's roles (admin, rider, driver).
# AUTH0_ROLES_CLAIM=https://rideshare.app/roles

# Local Dev sign-in (always off in production, and when Auth0 is configured).
MOCK_OAUTH_ENABLED=true

# ---- Ports ----
API_PORT=3000
ADMIN_APP_PORT=3002
MOCK_OAUTH_PORT=4000

# ---- Storage ----
DATABASE_PATH=data/rideshare.db
UPLOAD_DIR=data/uploads

# ---- OpenStreetMap services ----
# The public servers are fine for development (light use, cached). Self-host or use a provider in production.
# NOMINATIM_URL=https://nominatim.openstreetmap.org
# OSRM_URL=https://router.project-osrm.org
# GEO_USER_AGENT=RideShare/1.0 (you@example.com)
# Search area bias (lon1,lat1,lon2,lat2) and countries; defaults to Mumbai, India.
# GEO_VIEWBOX=72.75,19.30,73.10,18.88
# GEO_COUNTRY_CODES=in
# OSRM assumes empty roads; durations are multiplied by this for city traffic.
# GEO_TRAFFIC_FACTOR=1.8

SMS_PROVIDER=console

# ---- Ola Maps (search, addresses, routes; the web app also uses it for map tiles) ----
# Key from https://maps.olakrutrim.com -> Maps Credentials (not the AI Studio "API keys" page).
# Without it, everything falls back to OpenStreetMap.
OLA_MAPS_API_KEY=
