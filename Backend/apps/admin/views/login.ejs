<%- include("partials/head") %>
<section class="card narrow">
    <a class="brand" href="/">
        <span class="brand-mark">R</span>
        <span>ride<span class="brand-accent">share</span></span>
        <span class="brand-tag">admin</span>
    </a>
    <h1 class="mt">Admin console</h1>
    <p class="muted">Sign in with an account that has the <strong>admin</strong> role in Auth0 to verify drivers and monitor the platform.</p>
    <%- include("partials/flash") %>

    <% if (!providers.length) { %>
    <div class="alert alert-error">No sign-in provider is configured. Set AUTH0_DOMAIN, AUTH0_ADMIN_CLIENT_ID and AUTH0_ADMIN_CLIENT_SECRET in .env.</div>
    <% } %>

    <div class="stack">
    <% for (const provider of providers) { %>
        <a class="provider-btn <%= provider.id === "mock" ? "provider-dev" : "" %>" href="/auth/<%= provider.id %><%= returnTo ? "?returnTo=" + encodeURIComponent(returnTo) : "" %>">
            <% if (provider.id === "mock") { %><span aria-hidden="true">🧪</span><% } %> Continue with <%= provider.label %>
        </a>
    <% } %>
    </div>
</section>
<%- include("partials/foot") %>
